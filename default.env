# Режим приложения
APP_ENV=production
SECRET_KEY=replace-with-at-least-32-random-characters
ADMIN_ROUTE_PREFIX=/x321/dashboard
ADMIN_EMAILS=admin@example.com

# Публичный host. Несколько значений — через запятую.
ALLOWED_HOSTS=jsinteractive.ru
SITE_BASE_URL=https://jsinteractive.ru
BEHIND_PROXY=true
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_NAME=jsint_session
SESSION_LIFETIME_HOURS=12
MAX_CONTENT_LENGTH=2097152
# Медиатека. По умолчанию разрешены оптимизированные изображения до 2 МБ.
MEDIA_STORAGE_PATH=/var/lib/jsint-site/media
MEDIA_UPLOAD_MAX_BYTES=2097152
LOG_LEVEL=INFO
APP_BIND=127.0.0.1:18080
GUNICORN_WORKERS=1
GUNICORN_THREADS=4
CELERY_CONCURRENCY=1

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=jsint
DB_USER=jsint
DB_PASSWORD=replace-with-strong-database-password
DB_SSLMODE=prefer

# Redis используется для кеша и production rate-limit входа.
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_REQUIRED=true
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
AUTH_RATE_LIMIT_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=300

# Защита публичной формы обратной связи.
# Короткий лимит, суточный лимит, глобальный предохранитель и дедупликация
# работают до записи обращения в PostgreSQL.
CONTACT_RATE_LIMIT_ATTEMPTS=3
CONTACT_RATE_LIMIT_WINDOW_SECONDS=900
CONTACT_DAILY_LIMIT_ATTEMPTS=10
CONTACT_DAILY_LIMIT_WINDOW_SECONDS=86400
CONTACT_GLOBAL_LIMIT_ATTEMPTS=120
CONTACT_GLOBAL_LIMIT_WINDOW_SECONDS=600
CONTACT_REPLY_LIMIT_ATTEMPTS=3
CONTACT_DUPLICATE_WINDOW_SECONDS=604800
CONTACT_FORM_MIN_SECONDS=3
CONTACT_FORM_TTL_SECONDS=1800
CONTACT_MAX_URLS=3
CONTACT_MAX_REQUEST_BYTES=16384

# Рекомендуется включить Turnstile в production. Если REQUIRED=true,
# приложение не стартует без обоих ключей и не принимает форму без
# успешной server-side проверки токена.
CONTACT_TURNSTILE_SITE_KEY=
CONTACT_TURNSTILE_SECRET_KEY=
CONTACT_TURNSTILE_REQUIRED=false

# Оставьте пустым, чтобы не включать Метрику.
YANDEX_METRIKA_ID=

# Подтверждение прав в Яндекс Вебмастере через meta yandex-verification.
YANDEX_WEBMASTER_VERIFICATION=725d05a47d08b13d

# IndexNow автоматически сообщает Яндексу об изменённых публичных URL.
# Ключ публикуется в корне сайта в файле <ключ>.txt и секретом не является.
YANDEX_INDEXNOW_ENABLED=true
YANDEX_INDEXNOW_KEY=jsinteractive-indexnow-725d05a47d08b13d


# --------------------------------------------
# Workspace Organizer: лицензии и релизы
# Публичные ключи подписи находятся в config/notes_trust.py; private keys сюда не помещаются.
# NOTES_UPDATE_BASE_URL должен точно совпадать с --server в bin/update_activate.php клиента.
# --------------------------------------------
NOTES_CONTROL_PLANE_ENABLED=true
NOTES_UPDATE_API_PREFIX=/api/notes/v1
NOTES_UPDATE_BASE_URL=https://jsinteractive.ru/api/notes/v1/
NOTES_RELEASE_STORAGE_PATH=/var/lib/jsint-site/notes-releases
NOTES_RELEASE_UPLOAD_MAX_BYTES=536870912

# Автоматическая подготовка update release из официального GitHub Release.
# Для публичного репозитория token оставьте пустым. Для private используйте
# отдельный read-only token и не коммитьте его значение.
NOTES_RELEASE_GITHUB_REPOSITORY=cyrox007/Notes
NOTES_RELEASE_GITHUB_TOKEN=
NOTES_RELEASE_DEFAULT_REQUIRES_PHP=8.1.0

# Append-only журнал control plane. Записи не удаляются приложением автоматически.
OPERATOR_AUDIT_RETENTION_DAYS=730
# Отключённые лицензии удаляются планировщиком не раньше чем через 30 дней.
LICENSE_REVOKED_RETENTION_DAYS=30

# Локальный signer запускается на ПК оператора и доступен браузеру только через loopback.
# Private keys никогда не копируются на web-сервер.
NOTES_OPERATOR_SIGNER_URL=http://127.0.0.1:17843/v1


# --------------------------------------------
# Vanga: публичная демонстрация модели
# Сервис Vanga должен слушать только loopback; jsint-site проксирует запросы.
# --------------------------------------------
VANGA_DEMO_URL=http://127.0.0.1:9100
VANGA_DEMO_TIMEOUT_SECONDS=10


# --------------------------------------------
# Уведомления администратора
# Можно указать приватный ntfy topic URL, например https://ntfy.sh/<случайный-topic>.
# Для защищённого/self-hosted ntfy задайте Bearer token.
# В push не отправляется содержимое диагностических архивов.
# --------------------------------------------
ADMIN_PUSH_URL=
ADMIN_PUSH_TOKEN=
ADMIN_PUSH_TIMEOUT_SECONDS=8

# Диагностика Workspace Organizer хранится вне дерева приложения.
NOTES_DIAGNOSTIC_STORAGE_PATH=/var/lib/jsint-site/diagnostics
NOTES_DIAGNOSTIC_UPLOAD_MAX_BYTES=10485760
