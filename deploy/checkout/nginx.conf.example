server {
    listen 80;
    listen [::]:80;

    server_name jsinteractive.ru www.jsinteractive.ru;
    server_tokens off;

    return 301 https://jsinteractive.ru$request_uri;
}

# Единственный поисковый канонический host — без www.
# Сертификат здесь тот же, который ранее обслуживал оба имени.
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;

    server_name www.jsinteractive.ru;
    server_tokens off;

    ssl_certificate /etc/letsencrypt/live/jsinteractive.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/jsinteractive.ru/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    return 301 https://jsinteractive.ru$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;

    server_name jsinteractive.ru;
    server_tokens off;
    client_max_body_size 2m;

    # Существующий сертификат Certbot для jsinteractive.ru.
    ssl_certificate /etc/letsencrypt/live/jsinteractive.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/jsinteractive.ru/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Загрузка release ZIP из админки. Маршрут требует обычную admin session
    # и CSRF, но принимает большие multipart uploads потоково.
    location = /api/operator/v1/release-upload {
        client_max_body_size 520m;

        proxy_pass http://127.0.0.1:18080;
        proxy_http_version 1.1;
        proxy_request_buffering off;
        proxy_buffering off;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        proxy_connect_timeout 5s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
        proxy_redirect off;
    }

    # Machine API Workspace Organizer. ZIP может быть большим, поэтому
    # отдаём ответ потоково и сохраняем заголовки клиентской авторизации.
    location /api/notes/v1/ {
        # Диагностический ZIP Notes ограничен приложением 10 МБ.
        client_max_body_size 12m;

        proxy_pass http://127.0.0.1:18080;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_request_buffering off;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Notes-Installation $http_x_notes_installation;

        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 300s;
        proxy_redirect off;
    }

    # Публичный сайт и административная панель.
    location / {
        proxy_pass http://127.0.0.1:18080;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
        proxy_redirect off;
    }
}
