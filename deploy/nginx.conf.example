server {
    listen 80;
    listen [::]:80;
    server_name jsinteractive.ru www.jsinteractive.ru;

    return 301 https://jsinteractive.ru$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.jsinteractive.ru;

    ssl_certificate /etc/letsencrypt/live/jsinteractive.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/jsinteractive.ru/privkey.pem;

    return 301 https://jsinteractive.ru$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name jsinteractive.ru;

    ssl_certificate /etc/letsencrypt/live/jsinteractive.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/jsinteractive.ru/privkey.pem;

    server_tokens off;
    client_max_body_size 2m;

    location /static/ {
        alias /opt/jsint-site/current/static/;
        access_log off;
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
    }

    location / {
        proxy_pass http://127.0.0.1:18080;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
        proxy_redirect off;
    }
}
