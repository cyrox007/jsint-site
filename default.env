# Режим приложения
APP_ENV=production
SECRET_KEY=replace-with-at-least-32-random-characters
ADMIN_ROUTE_PREFIX=/x321/dashboard
ADMIN_EMAILS=admin@example.com

# Публичный host. Несколько значений — через запятую.
ALLOWED_HOSTS=jsinteractive.ru
# Канонический адрес используется в canonical, robots.txt и sitemap.xml.
SITE_CANONICAL_URL=https://jsinteractive.ru
BEHIND_PROXY=true
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_NAME=jsint_session
SESSION_LIFETIME_HOURS=12
MAX_CONTENT_LENGTH=2097152
LOG_LEVEL=INFO
APP_BIND=127.0.0.1:18080
GUNICORN_WORKERS=1
GUNICORN_THREADS=4
CELERY_CONCURRENCY=1

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=jsint
DB_USER=jsint
DB_PASSWORD=replace-with-strong-database-password
DB_SSLMODE=prefer

# Redis используется для кеша и production rate-limit входа.
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_REQUIRED=true
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
AUTH_RATE_LIMIT_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=300

# Оставьте пустым, чтобы не включать Метрику.
YANDEX_METRIKA_ID=


# --------------------------------------------
# Workspace Organizer: лицензии и релизы
# Публичные ключи подписи находятся в config/notes_trust.py; private keys сюда не помещаются.
# NOTES_UPDATE_BASE_URL должен точно совпадать с --server в bin/update_activate.php клиента.
# --------------------------------------------
NOTES_CONTROL_PLANE_ENABLED=true
NOTES_UPDATE_API_PREFIX=/api/notes/v1
NOTES_UPDATE_BASE_URL=https://jsinteractive.ru/api/notes/v1/
NOTES_RELEASE_STORAGE_PATH=/var/lib/jsint-site/notes-releases
