[Unit]
Description=JSInteractive Flask application (checkout mode)
After=network-online.target redis-server.service
Wants=network-online.target

[Service]
Type=simple
User=jsint-site
Group=jsint-site
WorkingDirectory=/home/projects/js
Environment=APP_BIND=127.0.0.1:18080
Environment=GUNICORN_WORKERS=1
Environment=GUNICORN_THREADS=4
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/home/projects/js/.env
ExecStart=/home/projects/js/.venv/bin/gunicorn --bind ${APP_BIND} --workers ${GUNICORN_WORKERS} --threads ${GUNICORN_THREADS} --timeout 30 --graceful-timeout 20 --access-logfile - --error-logfile - wsgi:app
Restart=on-failure
RestartSec=3
TimeoutStopSec=30

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/home/projects/js
ReadWritePaths=/var/lib/jsint-site/notes-releases

[Install]
WantedBy=multi-user.target
